# TLS for the production API. Caddy gets and renews the certificate on its own,
# as long as the domain's DNS already points at this server and port 80 is open.
# The domain comes from /opt/ficha/.env, through compose.yaml.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$PROD_DOMAIN} {
	import common
	# The serving slot, api-blue or api-green: one reverse_proxy line that
	# deploy.sh rewrites before `caddy reload` (ops/README.md, *Blue/green*).
	# A reload is graceful: requests already proxied finish on the old slot.
	import /etc/caddy/active/upstream.caddy
}
