# TLS for the production API. Caddy gets and renews the certificate on its own,
# as long as the domain's DNS already points at this server and port 80 is open.
# The domain comes from /opt/ficha/.env, through compose.yaml.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$PROD_DOMAIN} {
	import common
	reverse_proxy api-prod:3001
}
