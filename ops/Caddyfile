# TLS for both environments. Caddy gets and renews the certificates on its own,
# as long as each domain's DNS already points at this server and port 80 is open.
# The domains come from /opt/ficha/.env, through compose.yaml.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$PROD_DOMAIN} {
	import common
	reverse_proxy api-prod:3001
}

{$STAGING_DOMAIN} {
	import common
	reverse_proxy api-staging:3001
}
