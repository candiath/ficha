# Template of /opt/ficha/prod.env and /opt/ficha/staging.env: one per
# environment, each with its own values (own Neon branch, own secret, own bot).
# On the server: owned by root, mode 600. Never commit a filled-in copy.
# Copy each environment's values from its Render service before shutting it down.

NODE_ENV=production
PORT=3001

# Neon, this environment's branch. DATABASE_URL is the pooled host (-pooler),
# which the app uses; DIRECT_DATABASE_URL is the same host without -pooler,
# which migrations need (with the pooler they fail with P1002).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Required; different from every other environment's.
PLATFORM_JWT_SECRET=
# PLATFORM_JWT_EXPIRES_IN=

# The web origin allowed to call this API: https://fichita.netlify.app for
# production, https://dev--fichita.netlify.app for staging.
CORS_ORIGIN=

# Sysadmin alerts (docs/infra.md#sysadmin-alerts-telegram): this
# environment's own bot, never another environment's.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The label at the start of every alert. The app reads Render's variable name;
# keep the Render service names so the labels stay the same.
# Production: Ficha. Staging: ficha-staging.
RENDER_SERVICE_NAME=
