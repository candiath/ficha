# Deploys one environment of the API if its image changed (ops/deploy.sh).
# Instance: ficha-deploy@prod (staging runs on Render). Started by the timer.
[Unit]
Description=Ficha API deploy (%i)
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/ficha/deploy.sh %i
