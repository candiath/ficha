# Template of /opt/ficha/.env, which Docker Compose reads for the ${...} in
# compose.yaml. No secrets here: those go in prod.env.

# The API's public name. It needs a DNS A record pointing at this server
# before Caddy can get its certificate.
PROD_DOMAIN=

# Image tag production runs. `main` follows its branch: a new image is
# deployed within 5 minutes. To roll back, pin the previous commit's tag
# (sha- plus the full 40-character SHA) and run `deploy.sh prod`; while
# pinned, new images are ignored. Back to `main` once fixed.
PROD_TAG=main

# Empty: blue/green deploys, no cut. `always`: every deploy stops the old API
# before starting the new one (a cut of ~20 s), for when the server cannot
# hold two APIs. The API alerts on every start while it is set. For a single
# deploy, `deploy.sh prod --no-blue-green` instead (ops/README.md).
DEPLOY_NO_BLUE_GREEN=
