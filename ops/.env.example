# Template of /opt/ficha/.env, which Docker Compose reads for the ${...} in
# compose.yaml. No secrets here: those go in prod.env and staging.env.

# The API's public names. Each needs a DNS A record pointing at this server
# before Caddy can get its certificate.
PROD_DOMAIN=
STAGING_DOMAIN=

# Image tag each environment runs. `main` and `dev` follow their branch: a new
# image is deployed within 5 minutes. To roll back, pin the previous commit's
# tag (sha- plus the full 40-character SHA) and run `deploy.sh <env>`; while
# pinned, new images are ignored. Back to `main` / `dev` once fixed.
PROD_TAG=main
STAGING_TAG=dev
