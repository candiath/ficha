{
    "chat.tools.terminal.autoApprove": {
        "npm audit": true,
        "npx tsc": true,
        "npm run dev:api": true
    },

    // Baja la severidad SOLO en el editor. La CLI (`eslint .`, `npm run check`,
    // el hook de pre-push) sigue viendo estas reglas como error, asi que nada
    // de esto llega a dev. Es puro ruido visual: distingue "todavia no lo use"
    // de un bug real.
    "eslint.rules.customizations": [
        { "rule": "@typescript-eslint/no-unused-vars", "severity": "warn" },
        { "rule": "no-unused-vars", "severity": "warn" }
    ]
}
