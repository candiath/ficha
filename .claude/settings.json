{
  "permissions": {
    "allow": [
      "Bash(npx prisma:*)",

      "Bash(curl *localhost:3001*)",
      "PowerShell(Get-Process -Name node)",
      "PowerShell(npm run dev -w apps/api)",
      "PowerShell($deadline = \\(Get-Date\\).AddSeconds\\(30\\); do { try { $r = Invoke-RestMethod http://localhost:3001/health -TimeoutSec 2; break } catch { Start-Sleep -Milliseconds 500 } } while \\(\\(Get-Date\\) -lt $deadline\\); $r | ConvertTo-Json -Compress)",
      "PowerShell(Get-NetTCPConnection -LocalPort 3001 -State Listen -ErrorAction SilentlyContinue | % { taskkill /PID $_.OwningProcess /T /F })",

      "mcp__plugin_render_render__list_logs",
      "mcp__plugin_render_render__list_services",
      "mcp__plugin_render_render__get_service",
      "mcp__plugin_render_render__get_deploy",
      "mcp__plugin_render_render__list_deploys",
      "mcp__plugin_render_render__list_events",
      "mcp__plugin_render_render__get_metrics",
      "mcp__plugin_render_render__list_workspaces",
      "mcp__plugin_render_render__get_selected_workspace",
      "mcp__neon__create_branch"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout *-- *)",
      "Bash(npm publish:*)",
      "Bash(npm uninstall:*)",

      "Bash(gh pr merge:*)",
      "Bash(gh pr create *-B main*)",
      "Bash(gh pr create *--base main*)",

      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push*)",

      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api graphql*)",

      "Bash(rm -rf:*)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git reset*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout *-- *)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr create *-B main*)",
      "PowerShell(gh pr create *--base main*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--delete*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--all*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git clean -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=$(node -e 'const j=JSON.parse(require(\"fs\").readFileSync(0,\"utf8\"));console.log((j.tool_input.file_path||\"\").split(String.fromCharCode(92)).join(\"/\"))'); case \"$f\" in */apps/web/*.ts|*/apps/web/*.tsx) app=web ;; */apps/api/*.ts) app=api ;; *) exit 0 ;; esac; out=$(cd \"${f%/apps/$app/*}/apps/$app\" && npx eslint \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 60,
            "statusMessage": "eslint en el archivo editado…"
          }
        ]
      }
    ]
  }
}
