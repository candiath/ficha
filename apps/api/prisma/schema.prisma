generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-tenancy row-level: TODA tabla de dominio lleva tenantId para garantizar
// que no se filtren datos entre clínicas. Sin excepción.
// Tablas de catálogo global (body_regions) son la única excepción permitida.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  patients            Patient[]
  sessions            Session[]
  initialEvaluations  InitialEvaluation[]
  techniques          Technique[]
  sessionPackages     SessionPackage[]
  payments            Payment[]
  informedConsents    InformedConsent[]
  auditLogs           AuditLog[]
  clinicalAlerts      ClinicalAlert[]
  functionalScales    FunctionalScale[]
  clinicalEpisodes    ClinicalEpisode[]

  @@map("tenants")
}

enum UserRole {
  ADMIN
  THERAPIST
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(THERAPIST)
  // Desactivar un usuario revoca su acceso sin borrar la fila: las sesiones
  // y registros de auditoría que creó deben seguir apuntando a él.
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([tenantId])
  @@map("users")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  fullName         String    @map("full_name")
  birthDate        DateTime? @map("birth_date") @db.Date
  sex              Sex?
  phone            String?
  occupation       String?
  referringDoctor  String?   @map("referring_doctor")
  insuranceName    String?   @map("insurance_name")
  insuranceNumber  String?   @map("insurance_number")
  insurancePlan    String?   @map("insurance_plan")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  // Borrado lógico: null = activo. Nunca se hace hard delete de pacientes
  // para preservar historia clínica, pagos y registro de auditoría.
  deletedAt        DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  sessions           Session[]
  initialEvaluations InitialEvaluation[]
  sessionPackages    SessionPackage[]
  payments           Payment[]
  informedConsent    InformedConsent?
  auditLogs          AuditLog[]
  clinicalAlerts     ClinicalAlert[]
  functionalScales   FunctionalScale[]
  clinicalEpisodes   ClinicalEpisode[]

  @@index([tenantId])
  @@map("patients")
}

enum EpisodeStatus {
  ACTIVE
  DISCHARGED
  ABANDONED
}

model ClinicalEpisode {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  patientId     String        @map("patient_id")
  status        EpisodeStatus @default(ACTIVE)
  mainComplaint String?       @map("main_complaint")
  openedAt      DateTime      @default(now()) @map("opened_at")
  closedAt      DateTime?     @map("closed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  patient           Patient             @relation(fields: [patientId], references: [id])
  initialEvaluation InitialEvaluation?
  sessions          SessionEpisode[]
  functionalScales  FunctionalScale[]

  @@index([tenantId])
  @@index([patientId])
  @@map("clinical_episodes")
}

model InitialEvaluation {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  patientId               String   @map("patient_id")
  episodeId               String?  @unique @map("episode_id")
  globalPosture           String?  @map("global_posture")
  breathingPattern        String?  @map("breathing_pattern")
  medicalHistory          String?  @map("medical_history")
  reasonForConsultation   String?  @map("reason_for_consultation")
  notes                   String?
  morphotype              String?
  retractionMap           Json?    @map("retraction_map")
  footEvaluation          String?  @map("foot_evaluation")
  breathingPatternDetail  String?  @map("breathing_pattern_detail")
  flexibilityNotes        String?  @map("flexibility_notes")
  physicalActivity        String?  @map("physical_activity")
  painAppearanceMoment    String?  @map("pain_appearance_moment")
  painFrequency           String?  @map("pain_frequency")
  familyPainAppearance    Json?    @map("family_pain_appearance")
  familyPainDisappearance Json?    @map("family_pain_disappearance")
  postureFamilies         Json?    @map("posture_families")
  evaScale                Int?     @map("eva_scale")
  evaluatedAt             DateTime @default(now()) @map("evaluated_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  patient Patient          @relation(fields: [patientId], references: [id])
  episode ClinicalEpisode? @relation(fields: [episodeId], references: [id])
  photos  EvaluationPhoto[]

  @@index([tenantId])
  @@index([patientId])
  @@map("initial_evaluations")
}

model EvaluationPhoto {
  id                  String   @id @default(uuid())
  initialEvaluationId String   @map("initial_evaluation_id")
  storageKey          String   @map("storage_key")
  caption             String?
  takenAt             DateTime? @map("taken_at")
  createdAt           DateTime @default(now()) @map("created_at")

  initialEvaluation InitialEvaluation @relation(fields: [initialEvaluationId], references: [id])

  @@map("evaluation_photos")
}

enum SessionType {
  SESSION
  NOTE
  DISCHARGE
}

model Session {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  patientId        String      @map("patient_id")
  userId           String      @map("user_id")
  sessionType      SessionType @default(SESSION) @map("session_type")
  sessionDate      DateTime    @map("session_date")
  preSesionState   String?     @map("pre_session_state")
  reEvaluationNotes String?    @map("re_evaluation_notes")
  patientResponse  String?     @map("patient_response")
  painScaleBefore  Int?        @map("pain_scale_before")
  painScaleAfter   Int?        @map("pain_scale_after")
  observations     String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  patient    Patient           @relation(fields: [patientId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  episodes   SessionEpisode[]
  photos     SessionPhoto[]
  techniques SessionTechnique[]
  payment    Payment?

  @@index([tenantId])
  @@index([patientId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pivote sesión ↔ episodio (M:N): una misma sesión puede abordar varios motivos
// de consulta a la vez (p. ej. cervicalgia y lumbalgia en la misma visita), y un
// episodio agrupa todas las sesiones que trabajaron ese motivo.
// ─────────────────────────────────────────────────────────────────────────────
model SessionEpisode {
  sessionId String @map("session_id")
  episodeId String @map("episode_id")

  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  episode ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([sessionId, episodeId])
  @@index([episodeId])
  @@map("session_episodes")
}

model SessionPhoto {
  id         String    @id @default(uuid())
  sessionId  String    @map("session_id")
  storageKey String    @map("storage_key")
  caption    String?
  takenAt    DateTime? @map("taken_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id])

  @@map("session_photos")
}

// tenant_id nullable: null = técnica global (disponible a todos los tenants),
// valor = técnica personalizada de ese tenant.
model Technique {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  name      String
  isGlobal  Boolean  @default(false) @map("is_global")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant?           @relation(fields: [tenantId], references: [id])
  sessions SessionTechnique[]

  @@index([tenantId])
  @@map("techniques")
}

// Catálogo global de regiones corporales. Sin tenant_id: es compartido.
model BodyRegion {
  id        String   @id @default(uuid())
  name      String
  zone      String?
  createdAt DateTime @default(now()) @map("created_at")

  sessions SessionTechnique[]

  @@map("body_regions")
}

// Catálogo global de cadenas musculares según el Método Souchard (RPG).
// Sin tenant_id: es compartido por todos los tenants.
model MuscularChain {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  sessions SessionTechnique[]

  @@map("muscular_chains")
}

model SessionTechnique {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  techniqueId     String   @map("technique_id")
  bodyRegionId    String?  @map("body_region_id")
  muscularChainId String?  @map("muscular_chain_id")
  variantNotes    String?  @map("variant_notes")
  createdAt       DateTime @default(now()) @map("created_at")

  session       Session       @relation(fields: [sessionId], references: [id])
  technique     Technique     @relation(fields: [techniqueId], references: [id])
  bodyRegion    BodyRegion?   @relation(fields: [bodyRegionId], references: [id])
  muscularChain MuscularChain? @relation(fields: [muscularChainId], references: [id])

  @@map("session_techniques")
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

// Un paquete de sesiones prepagadas para un paciente.
// El precio individual se fija al crear el paquete.
// Las sesiones debitan del paquete usando packageId en Payment.
model SessionPackage {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  patientId       String   @map("patient_id")
  name            String
  totalSessions   Int      @map("total_sessions")
  pricePerSession Decimal  @map("price_per_session") @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  patient  Patient   @relation(fields: [patientId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([patientId])
  @@map("session_packages")
}

// Un cobro por sesión. Se crea junto con la sesión (status PENDING).
// discount y finalAmount permiten descuentos granulares.
model Payment {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  patientId   String         @map("patient_id")
  sessionId   String         @unique @map("session_id")
  packageId   String?        @map("package_id")

  baseAmount  Decimal        @map("base_amount") @db.Decimal(10, 2)
  discount    Decimal        @default(0) @db.Decimal(10, 2)
  finalAmount Decimal        @map("final_amount") @db.Decimal(10, 2)

  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  paidAt      DateTime?      @map("paid_at")
  notes       String?

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  patient  Patient         @relation(fields: [patientId], references: [id])
  session  Session         @relation(fields: [sessionId], references: [id])
  package  SessionPackage? @relation(fields: [packageId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([sessionId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consentimiento informado: un paciente firma (o no) antes de iniciar tratamiento.
// ─────────────────────────────────────────────────────────────────────────────
model InformedConsent {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  patientId String    @unique @map("patient_id")
  signed    Boolean   @default(false)
  signedAt  DateTime? @map("signed_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("informed_consents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Registro de auditoría: cambios en las entidades clínicas de un paciente.
// ─────────────────────────────────────────────────────────────────────────────
enum AuditAction {
  CREATED
  UPDATED
  DELETED
}

enum AuditEntity {
  PATIENT
  EVALUATION
  SESSION
  PAYMENT
  CONSENT
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  patientId   String      @map("patient_id")
  userId      String?     @map("user_id")
  entity      AuditEntity
  entityId    String      @map("entity_id")
  action      AuditAction
  description String
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  // SetNull: si se borra el usuario, el registro de auditoría se conserva
  // (la historia clínica no puede perder entradas) pero queda sin actor.
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([patientId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Alertas clínicas automáticas: seguimiento, cobros, inasistencias.
// ─────────────────────────────────────────────────────────────────────────────
enum AlertType {
  FOLLOW_UP
  NO_SHOW
  PAYMENT
  CUSTOM
}

model ClinicalAlert {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  patientId String    @map("patient_id")
  type      AlertType
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([isRead])
  @@map("clinical_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Escalas funcionales estandarizadas (Oswestry, NDI).
// responses almacena el mapa {pregunta: valor} como JSON.
// score e interpretation se calculan en el servidor al momento de guardar.
// ─────────────────────────────────────────────────────────────────────────────

enum ScaleType {
  OSWESTRY
  NDI
}

model FunctionalScale {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  patientId      String    @map("patient_id")
  episodeId      String?   @map("episode_id")
  scaleType      ScaleType @map("scale_type")
  responses      Json
  score          Int
  interpretation String
  appliedAt      DateTime  @default(now()) @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  patient Patient          @relation(fields: [patientId], references: [id])
  episode ClinicalEpisode? @relation(fields: [episodeId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([episodeId])
  @@index([appliedAt])
  @@map("functional_scales")
}
