generator client {
  provider = "prisma-client-js"
}

// La app va por el pooler de Neon (PgBouncer), que es lo que queremos para
// conexiones cortas y muchas. Las migraciones NO: `prisma migrate` toma un
// advisory lock de sesión, y en modo transacción PgBouncer no garantiza la
// misma conexión física entre statements — el lock se pierde y el migrate
// muere con P1002. `directUrl` es el mismo host sin `-pooler`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-tenancy row-level: TODA tabla de dominio lleva tenantId para garantizar
// que no se filtren datos entre clínicas. Sin excepción.
// Tablas de catálogo global (body_regions) son la única excepción permitida.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Ids: UUIDv7 en columnas `uuid` nativas (issue #174). Toda PK y toda columna
// que guarda un id lleva @db.Uuid — una FK tiene que tener el mismo tipo que
// la columna a la que apunta.
//
// El tipo nativo es para que la base rechace un id malformado por
// construcción. El costo: Prisma ya no devuelve "no encontrado" para un id con
// otra forma, sino P2023. Por eso la API valida el formato antes de consultar
// (params con 404, body con 400; ver lib/validation.ts y middlewares/idParam.ts).
//
// v7 y no v4: ordena por fecha de creación, así que un id dice cuándo nació la
// fila. Lo genera Prisma, no Postgres: la columna no tiene DEFAULT.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique

  // Datos de contacto y fiscales. Opcionales: una clínica recién creada solo
  // tiene nombre y slug, y estos se completan desde la pantalla de Clínica.
  // Hacen falta para el membrete de los informes imprimibles.
  email     String?
  phone     String?
  address   String?
  cuit      String?
  specialty String?

  // Zona horaria IANA de la clínica. NO es cosmética: un turno "de 9:00" es
  // hora de pared, pero se guarda como instante UTC. Sin esto, agrupar por
  // día o por semana se hace en UTC y una sesión de las 22:00 de fin de mes
  // cae en el mes siguiente (el dashboard ya documenta ese corrimiento).
  timezone  String   @default("America/Argentina/Buenos_Aires")

  // Horario de atención, en hora local de la clínica. Estructurado y no texto
  // libre porque la grilla de la agenda tiene que poder leerlo: hoy dibuja
  // 08:00-19:00 de lunes a sábado hardcodeado. Limitación conocida: un mismo
  // rango para todos los días laborables, así que "sábados solo a la mañana"
  // no se puede expresar todavía.
  workdayStart String @default("08:00") @map("workday_start")
  workdayEnd   String @default("20:00") @map("workday_end")
  // Días laborables, con la convención de Date#getDay(): 0 domingo … 6 sábado.
  workdays     Int[]  @default([1, 2, 3, 4, 5])

  // Última vez que corrió el motor de alertas para esta clínica.
  //
  // Las alertas se recalculan al leerlas, no por un cron —Render free no
  // tiene—, y esta marca evita rehacer el trabajo en cada request: el badge
  // del layout pide las stats en cada carga de página. La reclama se hace con
  // la condición en el where del update, así que dos requests simultáneos no
  // corren el motor dos veces.
  alertsRefreshedAt DateTime? @map("alerts_refreshed_at")

  // Clínica desactivada por el operador de plataforma (null = activa). Es
  // el borrado lógico de la clínica entera: todos sus usuarios pierden el
  // acceso en el request siguiente (authenticate y el login lo miran) y
  // nada se borra, así que reactivarla lo devuelve tal cual. Timestamp y no
  // boolean por lo mismo que deletedAt: importa desde cuándo.
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  patients            Patient[]
  sessions            Session[]
  initialEvaluations  InitialEvaluation[]
  sessionPackages     SessionPackage[]
  payments            Payment[]
  informedConsents    InformedConsent[]
  auditLogs           AuditLog[]
  clinicalAlerts      ClinicalAlert[]
  functionalScales    FunctionalScale[]
  clinicalEpisodes    ClinicalEpisode[]
  sessionEpisodes     SessionEpisode[]
  patientEvents       PatientEvent[]
  loginEvents         LoginEvent[]
  appointments        Appointment[]
  platformAuditLogs   PlatformAuditLog[]

  @@map("tenants")
}

enum UserRole {
  ADMIN
  THERAPIST
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(THERAPIST)
  // Desactivar un usuario revoca su acceso sin borrar la fila: las sesiones
  // y registros de auditoría que creó deben seguir apuntando a él.
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  loginEvents  LoginEvent[]
  appointments Appointment[]
  platformAuditLogs PlatformAuditLog[]
  authSessions AuthSession[]
  passwordResetTokens  PasswordResetToken[] @relation("PasswordResetTokenUser")
  passwordResetsIssued PasswordResetToken[] @relation("PasswordResetTokenIssuer")

  // Audit rows reference (tenant_id, id), so they cannot name another
  // clinic's user (#186); Postgres needs a unique constraint to reference.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Login sessions (docs/specs/SPEC-server-sessions.md). Named AuthSession
// because Session is the clinical therapy session.
//
// The client holds an opaque random token; only its SHA-256 is stored, so a
// leaked table or backup yields no usable session. Access is decided on every
// request by joining to users and tenants (active user, active clinic), not by
// this row alone: revoking here is for closing one session, the join is the
// safety net for any write path that forgets to revoke.
//
// No tenantId column: the owner is the user and the tenant comes from the
// join. A copied tenantId could drift from users.tenant_id.
//
// Retention: deleted 180 days after the session ended (revoked, expired, or
// idle past the longest idle timeout), by lib/retention.ts (#178). Audit rows
// keep the id, with no foreign key.
// ─────────────────────────────────────────────────────────────────────────────
model AuthSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // Refreshed by authenticate at most once every few minutes; drives idle
  // expiry and the "last activity" of the session list.
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  // "Mantener la sesión iniciada en este dispositivo": longer timeouts,
  // capped per user (lib/sessionPolicy.ts).
  trusted   Boolean   @default(false)
  // Captured at login for the session list: they cannot be backfilled later.
  ip        String?
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Single-use password reset links (docs/specs/SPEC-password-reset.md). An
// ADMIN or the platform operator generates one; generating it already
// revokes the user's sessions and disables her password, and using it sets
// the new one. Like auth_sessions, only sha256(token) is stored and there is
// no tenantId: the owner is the user.
//
// The created_by_* and network columns are evidence, not mechanics: they let
// the audit (#186) show who generated each link and from where it was
// generated and used — an ADMIN opening the link herself to impersonate a
// therapist leaves the same IP and browser on both sides. They exist only at
// that moment, so they are captured now even though nothing reads them yet.
model PasswordResetToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     Bytes     @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  // Retired by a newer link, or when another of her links is used.
  invalidatedAt DateTime? @map("invalidated_at")

  createdByUserId     String? @map("created_by_user_id") @db.Uuid
  createdByOperatorId String? @map("created_by_operator_id") @db.Uuid
  createdIp           String? @map("created_ip")
  createdUserAgent    String? @map("created_user_agent")
  usedIp              String? @map("used_ip")
  usedUserAgent       String? @map("used_user_agent")

  user              User              @relation("PasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser     User?             @relation("PasswordResetTokenIssuer", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByOperator PlatformOperator? @relation(fields: [createdByOperatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Operador de plataforma (issue #153): quien crea clínicas y les delega su
// primer ADMIN. Mantiene la plataforma; no es personal de salud de ninguna
// clínica y NO puede leer ni escribir nada clínico.
//
// Tabla aparte y no un tercer valor de UserRole, a propósito: todo el
// aislamiento entre clínicas se apoya en que ningún request cruza tenants
// (forTenant inyecta el tenantId en cada query). Un "SYSADMIN" dentro de
// users que "vea todas las clínicas" sería una excepción a esa regla en cada
// repositorio, y users.tenantId es obligatorio: el operador no pertenece a
// ninguna. Tiene su propio login, su propio hash y su propio secreto de JWT
// (PLATFORM_JWT_SECRET): un token de operador no lo acepta authenticate, ni
// uno de usuario el middleware de operador.
// ─────────────────────────────────────────────────────────────────────────────
model PlatformOperator {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String?
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  auditLogs   PlatformAuditLog[]
  loginEvents LoginEvent[]
  passwordResetsIssued PasswordResetToken[]
  testAlerts  SysadminAlert[]

  @@map("platform_operators")
}

// The object a platform_audit_logs row acted on (SPEC-audit-structured-entries.md).
// Codes are permanent.
enum PlatformAuditEntity {
  PASSWORD_RESET_TOKEN
  SYSADMIN_ALERT
}

// Declared with its parameters and wording in packages/shared/src/auditActions.ts
// (SPEC-audit-structured-entries.md). Codes are permanent.
enum PlatformAction {
  TENANT_CREATED
  TENANT_DEACTIVATED
  TENANT_REACTIVATED
  ADMIN_CREATED
  USER_ROLE_CHANGED
  // Deprecated: split into USER_DEACTIVATED and USER_REACTIVATED.
  USER_ACTIVE_CHANGED
  USER_DEVICES_DISCONNECTED
  PASSWORD_RESET_LINK_CREATED
  // An action on the platform itself: the only one with no clinic (a CHECK
  // on platform_audit_logs pins it). SPEC-sysadmin-alerts.md §2.
  TEST_ALERT_SENT
  USER_DEACTIVATED
  USER_REACTIVATED
}

// Cada acción del operador, con el operador como actor. Tabla propia y no
// audit_logs: aquélla es la auditoría clínica de un paciente (patientId
// obligatorio, scopeada por tenant), y esto registra quién tocó la
// plataforma. Se escribe en la misma transacción que la acción, así que no
// puede existir una acción sin su fila.
//
// Tiene columna tenantId pero queda FUERA del guard de tenant, declarado en
// TENANT_MODELS_FUERA_DEL_GUARD: la escribe alguien que no tiene tenant, y
// el tenantId es el objetivo de la acción, no el dueño de la fila.
//
// The clinic is null only for an action on the platform itself
// (TEST_ALERT_SENT), and a row with a target always names its clinic: two
// CHECKs in the migration, pinned by prisma/audit-guards.sql.
model PlatformAuditLog {
  id           String         @id @default(uuid(7)) @db.Uuid
  operatorId   String         @map("operator_id") @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  targetUserId String?        @map("target_user_id") @db.Uuid
  action       PlatformAction
  // Codes only, as in audit_logs (SPEC-audit-structured-entries.md).
  params       Json           @default("{}")
  // Always OPERATOR for now (a CHECK in the migration).
  actorType    AuditActorType @default(OPERATOR) @map("actor_type")
  // The object the action was on, when it is neither the clinic nor a user
  // (they have columns of their own): the reset link generated, the test
  // alert sent. Set from the catalog by recordPlatformAudit; no foreign key,
  // since it points at a different table by type. Both or neither (a CHECK).
  entity       PlatformAuditEntity?
  entityId     String?        @map("entity_id") @db.Uuid
  // Stamped by the database on insert (audit_rows_stamp_created_at), in UTC;
  // whatever the caller sends is replaced. (#186)
  createdAt    DateTime       @default(now()) @map("created_at")

  // Restrict everywhere (#186): an audit row can never change, so it cannot
  // lose its operator or target, and nobody it names can be deleted. The
  // target is a user of the row's own clinic.
  operator   PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetUser User?            @relation(fields: [tenantId, targetUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([createdAt])
  // One row per action on an object (a partial unique index in the
  // migration, WHERE entity IS NOT NULL; Prisma cannot express it).
  @@map("platform_audit_logs")
}

// ─── Sysadmin alerts (#186, docs/specs/SPEC-sysadmin-alerts.md) ──────────────
// What the platform operator is told by Telegram, and whether it reached her.
// Both tables are audit tables: append-only, created_at stamped by the
// database (the same triggers as platform_audit_logs), checked by
// prisma/audit-guards.sql. A kind names a fixed message: rows carry no text,
// no personal data and no values.
//
// No tenantId: an alert is about the platform, not a clinic. A producer that
// adds one classifies the models in TENANT_MODELS_FUERA_DEL_GUARD.

enum SysadminAlertKind {
  AUDIT_GUARDS_FAILED            // audit-guards.sql failed at startup
  AUDIT_MAINTENANCE_FLAG_PRESENT // no-audit-maintenance.sql failed at startup
  TEST                           // sent by the operator from /platform
}

enum SysadminAlertOutcome {
  SENT           // Telegram accepted it
  REJECTED       // Telegram answered ok: false; error_code says why
  UNREACHABLE    // no usable answer: network error, timeout, a body that is not Telegram's
  NOT_CONFIGURED // token or chat missing or malformed: nothing was sent
}

model SysadminAlert {
  id         String            @id @default(uuid(7)) @db.Uuid
  kind       SysadminAlertKind
  // Who sent a test alert; null for every other kind (a CHECK enforces it).
  operatorId String?           @map("operator_id") @db.Uuid
  // Stamped by the database on insert (audit_rows_stamp_created_at), in UTC.
  createdAt  DateTime          @default(now()) @map("created_at")

  operator   PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries SysadminAlertDelivery[]

  @@index([createdAt])
  @@map("sysadmin_alerts")
}

// One row per delivery attempt of an alert.
model SysadminAlertDelivery {
  id        String               @id @default(uuid(7)) @db.Uuid
  alertId   String               @map("alert_id") @db.Uuid
  outcome   SysadminAlertOutcome
  // Telegram's error_code, only when it rejected the message (a CHECK).
  errorCode Int?                 @map("error_code")
  // Why it was not sent: Telegram's description, the network error's code, or
  // the variables' names. Redacted (lib/telegram.ts) and cut to 200 characters.
  detail    String?              @db.VarChar(200)
  // Stamped by the database on insert, like the alert's.
  createdAt DateTime             @default(now()) @map("created_at")

  alert SysadminAlert @relation(fields: [alertId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([alertId, createdAt])
  @@index([createdAt])
  @@map("sysadmin_alert_deliveries")
}

// Telemetría de seguridad: cada intento de login, exitoso o fallido.
// Separado de AuditLog a propósito: aquél es la auditoría clínica por
// paciente (patientId obligatorio); esto sirve para detectar fuerza bruta
// y rastrear accesos.
model LoginEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Email tal como se intentó (normalizado): en un fallo puede no
  // corresponder a ningún usuario.
  email     String
  // tenantId y userId son nullable a diferencia del resto de las tablas de
  // dominio: un intento fallido contra un email desconocido no pertenece a
  // ninguna clínica ni usuario. Cuando el email sí existe se guardan ambos,
  // y eso permite filtrar los accesos por clínica y seguir el historial de
  // un usuario aunque después cambie su email.
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  // El login del operador de plataforma registra sus intentos acá mismo —
  // así el freno por cuenta, que cuenta por email, lo cubre sin código
  // aparte— y esta columna dice de quién fue un éxito sin tenant ni usuario.
  operatorId String? @map("operator_id") @db.Uuid
  success   Boolean
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // SetNull: si se borra el usuario, el evento se conserva sin actor.
  // No se pierde a quién apuntaba el intento: la columna email de arriba es
  // un dato propio de esta tabla (no viene de la relación) y queda intacta.
  tenant   Tenant?           @relation(fields: [tenantId], references: [id])
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  operator PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([email])
  @@map("login_events")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  fullName         String    @map("full_name")
  birthDate        DateTime? @map("birth_date") @db.Date
  sex              Sex?
  phone            String?
  occupation       String?
  referringDoctor  String?   @map("referring_doctor")
  insuranceName    String?   @map("insurance_name")
  insuranceNumber  String?   @map("insurance_number")
  insurancePlan    String?   @map("insurance_plan")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  // Borrado lógico: null = activo. Nunca se hace hard delete de pacientes
  // para preservar historia clínica, pagos y registro de auditoría.
  deletedAt        DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  sessions           Session[]
  initialEvaluations InitialEvaluation[]
  sessionPackages    SessionPackage[]
  payments           Payment[]
  informedConsent    InformedConsent?
  auditLogs          AuditLog[]
  clinicalAlerts     ClinicalAlert[]
  functionalScales   FunctionalScale[]
  clinicalEpisodes   ClinicalEpisode[]
  appointments       Appointment[]
  events             PatientEvent[]

  // Audit rows reference (tenant_id, id), so they cannot name another
  // clinic's patient (#186); Postgres needs a unique constraint to reference.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("patients")
}

enum EpisodeStatus {
  ACTIVE
  DISCHARGED
  ABANDONED
}

model ClinicalEpisode {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  status        EpisodeStatus @default(ACTIVE)
  mainComplaint String?       @map("main_complaint")
  openedAt      DateTime      @default(now()) @map("opened_at")
  closedAt      DateTime?     @map("closed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  patient           Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  initialEvaluation InitialEvaluation?
  sessions          SessionEpisode[]
  functionalScales  FunctionalScale[]
  appointments      Appointment[]

  // Referenced by SessionEpisode, so a block cannot name another clinic's or
  // another patient's episode.
  @@unique([tenantId, patientId, id])
  @@index([tenantId])
  @@index([patientId])
  @@map("clinical_episodes")
}

enum PatientEventKind {
  FRACTURE
  SURGERY
  TRAUMA
  DIAGNOSIS
  PAIN_ONSET
  OTHER
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
}

// Something the patient lived (#238): a fracture, a surgery, a diagnosis, the
// onset of a pain ("Antecedentes"). It belongs to the patient, not to a
// treatment, so it is written once and seen from every episode.
//
// Its date is partial, as the patient remembers it (packages/shared
// partialDate.ts): a date truncated to its precision, plus the precision and an
// "approximate" mark. "Hace dos meses" is stored as the month it meant, so it
// never ages. No date at all when the patient does not know; CHECKs in the
// migration keep the three columns consistent.
model PatientEvent {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  patientId           String           @map("patient_id") @db.Uuid
  kind                PatientEventKind
  description         String
  occurredOn          DateTime?        @map("occurred_on") @db.Date
  occurredPrecision   DatePrecision?   @map("occurred_precision")
  occurredApproximate Boolean          @default(false) @map("occurred_approximate")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  // Deleted logically, like sessions: one entered by mistake disappears from
  // the record, and the row stays for the audit trail.
  deletedAt           DateTime?        @map("deleted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@map("patient_events")
}

model InitialEvaluation {
  id                      String   @id @default(uuid(7)) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  patientId               String   @map("patient_id") @db.Uuid
  // Every evaluation is an episode's: it is only written from
  // /episodes/:episodeId/evaluation.
  episodeId               String   @unique @map("episode_id") @db.Uuid
  // The patient's account: what happened, how it started ("Relato del paciente").
  patientNarrative        String?  @map("patient_narrative")
  // What the patient's history list (PatientEvent) does not hold: something
  // exceptional ("Otros antecedentes").
  otherHistory            String?  @map("other_history")
  notes                   String?
  retractionMap           Json?    @map("retraction_map")
  flexibilityNotes        String?  @map("flexibility_notes")
  physicalActivity        String?  @map("physical_activity")
  painFrequency           String?  @map("pain_frequency")
  evaScale                Int?     @map("eva_scale")
  evaluatedAt             DateTime @default(now()) @map("evaluated_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  patient Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  episode ClinicalEpisode @relation(fields: [tenantId, patientId, episodeId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)

  // Prisma needs the foreign key's own columns unique for a one-to-one; the
  // single-column unique above already implies it.
  @@unique([tenantId, patientId, episodeId])
  @@index([tenantId])
  @@index([patientId])
  @@map("initial_evaluations")
}

enum SessionType {
  SESSION
  NOTE
  DISCHARGE
}

model Session {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  sessionType      SessionType @default(SESSION) @map("session_type")
  sessionDate      DateTime    @map("session_date")
  // Everything clinical about a problem the visit treated is in its block
  // (SessionEpisode). The session keeps the text of a note, which may belong
  // to no episode.
  observations     String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  // Borrado lógico, igual que Patient: una sesión cargada por error
  // desaparece de los listados pero la fila queda, para no romper el pivote
  // con episodios ni la auditoría, y para que el borrado sea reversible.
  // Su cobro sí se elimina de verdad al borrarla, pero solo puede estar
  // PENDING o WAIVED: una sesión ya cobrada no se deja borrar (409). El turno
  // del que salió, si hubo uno, queda sin sessionId para poder registrarla
  // de nuevo.
  deletedAt        DateTime?   @map("deleted_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  patient    Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // The therapist is a user of the session's own clinic.
  user       User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  episodes    SessionEpisode[]
  payment     Payment?
  appointment Appointment?

  // Referenced by SessionEpisode, so a block cannot name another clinic's or
  // another patient's session.
  @@unique([tenantId, patientId, id])
  @@index([tenantId])
  @@index([patientId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// A session's block for one of the episodes it treated (#238). One visit can
// treat several problems (the back and an ankle sprain, say): the session holds
// the date, therapist, type and payment, and each block everything clinical
// about one problem (how it arrived, the treatment, the pain, the
// re-evaluation, the exercises), so each episode's history and pain chart show
// only its own.
//
// The keys include tenant and patient, so a block cannot join a session and an
// episode of different clinics or patients. Restrict, not cascade: sessions
// are deleted logically and episodes are not deleted, so a hard delete that
// would take blocks with it is a mistake to stop.
// ─────────────────────────────────────────────────────────────────────────────
model SessionEpisode {
  tenantId          String  @map("tenant_id") @db.Uuid
  patientId         String  @map("patient_id") @db.Uuid
  sessionId         String  @map("session_id") @db.Uuid
  episodeId         String  @map("episode_id") @db.Uuid
  painScaleBefore   Int?    @map("pain_scale_before")
  painScaleAfter    Int?    @map("pain_scale_after")
  preSessionState   String? @map("pre_session_state")
  treatment         String?
  patientExercises  String? @map("patient_exercises")
  reEvaluationNotes String? @map("re_evaluation_notes")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  session Session         @relation(fields: [tenantId, patientId, sessionId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  episode ClinicalEpisode @relation(fields: [tenantId, patientId, episodeId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionId, episodeId])
  @@index([episodeId])
  @@index([tenantId])
  @@map("session_episodes")
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

// Money is stored in integer cents (BIGINT), in every column and in the API:
// arithmetic on cents is exact, and a price is never a float that rounds
// differently in two places. $1.234,56 is 123456; only the screen divides.

// Un paquete de sesiones prepagadas para un paciente.
// El precio individual se fija al crear el paquete.
// Las sesiones debitan del paquete usando packageId en Payment.
model SessionPackage {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  name            String
  totalSessions   Int      @map("total_sessions")
  pricePerSessionCents BigInt @map("price_per_session_cents")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  patient  Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payments Payment[]

  // Referenced by Payment, so a package pays only its own patient's sessions.
  @@unique([tenantId, patientId, id])
  @@index([tenantId])
  @@index([patientId])
  @@map("session_packages")
}

// Un cobro por sesión. Se crea junto con la sesión (status PENDING).
model Payment {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  patientId   String         @map("patient_id") @db.Uuid
  sessionId   String         @unique @map("session_id") @db.Uuid
  packageId   String?        @map("package_id") @db.Uuid

  // Cents; finalAmountCents = baseAmountCents - discountCents (a CHECK).
  baseAmountCents  BigInt    @map("base_amount_cents")
  discountCents    BigInt    @default(0) @map("discount_cents")
  finalAmountCents BigInt    @map("final_amount_cents")

  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  paidAt      DateTime?      @map("paid_at")
  notes       String?

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Session and package are the payment's own patient's.
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  patient  Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  session  Session         @relation(fields: [tenantId, patientId, sessionId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  package  SessionPackage? @relation(fields: [tenantId, patientId, packageId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)

  // Prisma needs the foreign key's own columns unique for a one-to-one; the
  // single-column unique above already implies it.
  @@unique([tenantId, patientId, sessionId])
  @@index([tenantId])
  @@index([patientId])
  @@index([sessionId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consentimiento informado: un paciente firma (o no) antes de iniciar tratamiento.
// ─────────────────────────────────────────────────────────────────────────────
model InformedConsent {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  patientId String    @unique @map("patient_id") @db.Uuid
  // A row exists once the patient signed, so signedAt always has a date.
  // Signed means signed and not revoked: derived in the DTO, never a column
  // that could disagree with the dates. Signing again sets a new signedAt and
  // clears revokedAt.
  signedAt  DateTime  @map("signed_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Prisma needs the foreign key's own columns unique for a one-to-one; the
  // single-column unique above already implies it.
  @@unique([tenantId, patientId])
  @@index([tenantId])
  @@map("informed_consents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Registro de auditoría: cambios en las entidades clínicas de un paciente.
// ─────────────────────────────────────────────────────────────────────────────
// One code per business fact, declared with its parameters and wording in
// packages/shared/src/auditActions.ts, which recordAudit validates against
// (#186, docs/specs/SPEC-audit-structured-entries.md). Codes are permanent:
// never renamed, reused or removed. CREATED, UPDATED and DELETED are the
// format before the catalog: deprecated, kept for the rows that have them.
enum AuditAction {
  CREATED
  UPDATED
  DELETED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_DELETED
  EVALUATION_CREATED
  EVALUATION_UPDATED
  SCALE_APPLIED
  SESSION_RECORDED
  NOTE_RECORDED
  DISCHARGE_RECORDED
  SESSION_UPDATED
  SESSION_DELETED
  PAYMENT_CREATED
  PAYMENT_UPDATED
  CONSENT_SIGNED
  CONSENT_REVOKED
  PATIENT_EVENT_RECORDED
  PATIENT_EVENT_UPDATED
  PATIENT_EVENT_DELETED
}

enum AuditEntity {
  PATIENT
  EVALUATION
  SESSION
  PAYMENT
  CONSENT
  SCALE
  PATIENT_EVENT
}

// Who acted, on every audit table: a person of a clinic, the platform
// operator, or the system itself (none yet). Present from the start so that
// no row is ever written without it.
enum AuditActorType {
  USER
  OPERATOR
  SYSTEM
}

model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  patientId   String      @map("patient_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  entity      AuditEntity
  entityId    String      @map("entity_id") @db.Uuid
  action      AuditAction
  // The action's parameters: codes only, never a value. Validated against the
  // catalog by recordAudit, and by audit_params_are_codes in the database.
  params      Json        @default("{}")
  // USER exactly when user_id is set (a CHECK in the migration).
  actorType   AuditActorType @default(USER) @map("actor_type")
  // The login this action came from: groups the actions of one session, and
  // resolves to its device and IP while the auth_sessions row exists. The
  // session's id, not its token: not a credential. No foreign key, because
  // auth_sessions rows are deleted with their user and pruned (#178), and the
  // audit row outlives them. Never in a clinic-facing DTO: only the user
  // herself may list her sessions. (#186, SPEC-audit-hardening.md §3)
  authSessionId String?   @map("auth_session_id") @db.Uuid
  // Stamped by the database on insert (audit_rows_stamp_created_at), in UTC;
  // whatever the caller sends is replaced. (#186)
  createdAt   DateTime    @default(now()) @map("created_at")

  // Restrict everywhere (#186): an audit row can never change, so it cannot
  // lose its patient or author, and neither can be deleted while it exists.
  // Patient and author belong to the row's own clinic.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  user    User?   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Alertas clínicas automáticas: seguimiento, cobros, inasistencias.
// ─────────────────────────────────────────────────────────────────────────────
enum AlertType {
  FOLLOW_UP
  NO_SHOW
  PAYMENT
  CUSTOM
}

model ClinicalAlert {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  type      AlertType
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([isRead])
  @@map("clinical_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Escalas funcionales estandarizadas (Oswestry, NDI).
// responses almacena el mapa {pregunta: valor} como JSON.
// score e interpretation se calculan en el servidor al momento de guardar.
// ─────────────────────────────────────────────────────────────────────────────

enum ScaleType {
  OSWESTRY
  NDI
}

model FunctionalScale {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  episodeId      String?   @map("episode_id") @db.Uuid
  scaleType      ScaleType @map("scale_type")
  responses      Json
  score          Int
  interpretation String
  appliedAt      DateTime  @default(now()) @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  patient Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  episode ClinicalEpisode? @relation(fields: [tenantId, patientId, episodeId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([episodeId])
  @@index([appliedAt])
  @@map("functional_scales")
}

// ─────────────────────────────────────────────────────────────────────────────
// Turnos.
//
// startsAt/endsAt son instantes UTC, pero la app habla en hora de pared de la
// clínica: la conversión vive en lib/clinicTime.ts y usa Tenant.timezone. Un
// turno "de las 9:00" no significa nada sin esa zona.
//
// endsAt explícito y no derivado de una duración: cambiar la duración por
// defecto no debe mover los turnos que ya estaban agendados.
//
// NO hay restricción de solapamiento a propósito. Dos turnos pueden pisarse
// —sobreturnos, un familiar que acompaña, una reprogramación de apuro— y
// prohibirlo en la base convertiría un caso normal en un error. La UI avisa
// cuando el horario ya está ocupado, pero deja seguir.
// ─────────────────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED // agendado, sin confirmar
  CONFIRMED // el paciente confirmó
  COMPLETED // vino; normalmente con sessionId
  CANCELLED // avisó que no venía
  NO_SHOW   // no vino ni avisó
}

model Appointment {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  // Qué profesional atiende. Hoy todos ven todo, pero el turno es de alguien.
  userId    String @map("user_id") @db.Uuid
  // Por qué motivo. Opcional: se puede agendar antes de abrir el episodio.
  episodeId String? @map("episode_id") @db.Uuid

  // La sesión que produjo este turno, si el paciente vino y se registró.
  // @unique: una sesión sale de un turno como mucho, así que marcar el mismo
  // turno como cumplido dos veces no puede duplicar la sesión.
  sessionId String? @unique @map("session_id") @db.Uuid

  // Los turnos recurrentes se materializan como filas independientes que
  // comparten este id. Cada una se mueve o se cancela sola, y además existe
  // "cancelar los que quedan de la serie" — el caso de un tratamiento de diez
  // sesiones que se suspende en la tercera. Sin tabla aparte: no hay nada que
  // guardar sobre la serie salvo que sus turnos son la misma.
  seriesId String? @map("series_id") @db.Uuid

  startsAt    DateTime          @map("starts_at")
  endsAt      DateTime          @map("ends_at")
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  cancelledAt DateTime?         @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Therapist, episode and session belong to the appointment's own clinic and
  // patient.
  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  patient Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  user    User             @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  episode ClinicalEpisode? @relation(fields: [tenantId, patientId, episodeId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  session Session?         @relation(fields: [tenantId, patientId, sessionId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)

  // La consulta de la agenda es siempre "los turnos de esta clínica entre dos
  // instantes": este índice compuesto es el que la sostiene.
  // Prisma needs the foreign key's own columns unique for a one-to-one; the
  // single-column unique above already implies it.
  @@unique([tenantId, patientId, sessionId])
  @@index([tenantId, startsAt])
  @@index([patientId])
  @@index([seriesId])
  @@map("appointments")
}
