# Copiá este archivo a .env y completá los valores

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ficha_dev"

# La misma base pero por conexión directa: en Neon es el mismo host sin
# `-pooler`. Solo la usa `prisma migrate`, que necesita mantener un advisory
# lock de sesión que PgBouncer no le garantiza. Obligatoria: el datasource
# la declara, así que sin ella los comandos de migración fallan.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST-SIN-POOLER:5432/ficha_dev"

PORT=3001

# Mínimo 32 caracteres; la API no arranca sin él.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de los tokens (opcional, default 12h). Formato de jsonwebtoken: 30m, 12h, 7d.
# JWT_EXPIRES_IN=12h

# En producción tiene que valer "production": además del modo de Express,
# gatea el guard del seed (sin esto el seed crearía los datos de demo,
# incluido admin@ficha.dev con contraseña conocida) y vuelve obligatorio
# CORS_ORIGIN.
# NODE_ENV=production

# Orígenes permitidos por CORS: exactos, separados por coma.
# Obligatorio en producción. En desarrollo localhost y las IPs de red
# local ya están permitidos, así que puede quedar vacío.
CORS_ORIGIN=
